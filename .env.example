# Clé API TMDB (v4 « Read Access Token » ou v3 « API key »)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Taille du catalogue importé (par défaut : 800 acteurs + 150 du cinéma français)
TMDB_ACTORS=
TMDB_FR_ACTORS=
# Emplacement de la base SQLite (par défaut : data/clap.db)
CLAP_DB_PATH=
# 1 pour accepter les cookies de session en HTTP hors localhost (tests uniquement)
CLAP_INSECURE_COOKIES=
