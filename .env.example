# Clé API TMDB (v4 « Read Access Token » ou v3 « API key »)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Emplacement de la base SQLite (par défaut : data/clap.db)
CLAP_DB_PATH=
# Connexion Google (console Google Cloud > API et services > Identifiants > ID client OAuth « Application Web »)
# URI de redirection autorisée : <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Adresse publique du site (ex. https://clap.app) ; par défaut, celle de la requête
APP_URL=
